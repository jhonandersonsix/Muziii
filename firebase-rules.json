{
  "rules": {
    "rooms": {
      "$code": {
        ".validate": "$code.matches(/^[A-Z2-9]{4}$/)",
        "owner": {
          ".read": false,
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.val() === auth.uid"
        },
        "state": {
          ".read": true,
          ".write": "auth != null && root.child('rooms').child($code).child('owner').val() === auth.uid"
        },
        "inbox": {
          ".read": "auth != null && root.child('rooms').child($code).child('owner').val() === auth.uid",
          "$msg": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && root.child('rooms').child($code).child('owner').val() === auth.uid))",
            ".validate": "!newData.exists() || (newData.child('type').isString() && newData.child('type').val().length < 10 && (!newData.child('name').exists() || newData.child('name').val().length <= 30))"
          }
        },
        "acks": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('rooms').child($code).child('owner').val() === auth.uid"
          }
        },
        "people": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.child('name').val().length <= 30"
          }
        }
      }
    }
  }
}
